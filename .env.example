# Copy this file to `.env` and fill in real values. NEVER commit `.env`
# (or any file containing a real key) to git — `.env` is already in
# .gitignore. Every variable below is optional except ANTHROPIC_API_KEY,
# which is required for the LLM multi-agent layer (Portfolio Manager,
# Devil's Advocate, Strategy Research) to run at all.
#
# This platform never stores Fidelity (or any brokerage) username,
# password, MFA codes, or session cookies anywhere — there is nothing to
# configure here for Fidelity, because there is no automated connection
# to Fidelity at all. See README.md "How Fidelity manual execution
# works."

# -------------------------------------------------------------- Required
# Your Anthropic API key (https://console.anthropic.com/). Used by
# src/llm/client.py's anthropic.Anthropic() client, which reads this
# variable automatically.
ANTHROPIC_API_KEY=

# -------------------------------------------------------- LLM model tiers
# Override which model each routing tier uses, without editing
# config/llm.yaml. Leave unset to use the defaults in that file.
OPTIONS_AGENT_LLM_HIGH_REASONING_MODEL=
OPTIONS_AGENT_LLM_ROUTINE_MODEL=

# -------------------------------------------------------------- Risk limits
# Every one of these overrides the matching default in
# config/risk_limits.yaml. Leave unset to use the shipped defaults —
# these exist for deliberate, reviewed policy changes only, never as a
# way to "get a trade approved" that the defaults would reject.
OPTIONS_AGENT_RISK_TARGET_RISK_PER_TRADE_PCT=
OPTIONS_AGENT_RISK_ABSOLUTE_MAX_RISK_PER_TRADE_PCT=
OPTIONS_AGENT_RISK_MAX_UNDERLYING_EXPOSURE_PCT=
OPTIONS_AGENT_RISK_MAX_SECTOR_EXPOSURE_PCT=
OPTIONS_AGENT_RISK_MIN_CASH_RESERVE_PCT=
OPTIONS_AGENT_RISK_NORMAL_MAX_CAPITAL_DEPLOYED_PCT=
OPTIONS_AGENT_RISK_ABSOLUTE_MAX_CAPITAL_DEPLOYED_PCT=
OPTIONS_AGENT_RISK_DRAWDOWN_WARNING_PCT=
OPTIONS_AGENT_RISK_DRAWDOWN_RISK_REDUCTION_PCT=
OPTIONS_AGENT_RISK_DRAWDOWN_HALT_PCT=
OPTIONS_AGENT_RISK_REDUCTION_SIZING_MULTIPLIER=
OPTIONS_AGENT_RISK_MIN_OPEN_INTEREST=
OPTIONS_AGENT_RISK_MIN_VOLUME=
OPTIONS_AGENT_RISK_MAX_BID_ASK_SPREAD_PCT=
OPTIONS_AGENT_RISK_HIGH_CORRELATION_THRESHOLD=
OPTIONS_AGENT_RISK_MAX_MARKET_DATA_AGE_MINUTES=
OPTIONS_AGENT_RISK_FREE_RATE=
OPTIONS_AGENT_RISK_QUANT_CROSS_CHECK_TOLERANCE_PCT=
OPTIONS_AGENT_RISK_MAX_STRESS_LOSS_PCT_OF_NAV=

# -------------------------------------------------------------- Validation
# Overrides for the 90-day paper-trading validation protocol
# (config/validation.yaml). Leave unset for the defaults.
OPTIONS_AGENT_VALIDATION_DURATION_DAYS=
OPTIONS_AGENT_VALIDATION_MIN_TRADES=
OPTIONS_AGENT_VALIDATION_PREFERRED_TRADES=
OPTIONS_AGENT_VALIDATION_STARTING_NAV=
OPTIONS_AGENT_VALIDATION_BOOTSTRAP_ITERATIONS=
OPTIONS_AGENT_VALIDATION_MONTE_CARLO_ITERATIONS=

# -------------------------------------------------------------- Dashboard
# Host/port the dashboard's FastAPI server binds to. Leave unset for
# 127.0.0.1:8000 (see scripts/start.sh / Makefile).
OPTIONS_AGENT_DASHBOARD_HOST=
OPTIONS_AGENT_DASHBOARD_PORT=
